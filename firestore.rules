rules_version = '2';

// These rules are the app's only security layer (ARCH-2). See docs/spec.md.
service cloud.firestore {
  match /databases/{database}/documents {

    // Google accounts, plus the three password test accounts (DATA-1).
    function isAllowed() {
      return request.auth != null && (
        request.auth.token.firebase.sign_in_provider == 'google.com'
        || request.auth.uid in [
          'PszxqNnvr4OB524qkxSRPYp6Znw1',
          'BSa5uSk3SLRF3k9yXStDqBMkd7p1',
          'ORK3IfATtUeR2GqtLEimcpzdSqu1'
        ]
      );
    }

    function boardPath(boardId) {
      return /databases/$(database)/documents/boards/$(boardId);
    }

    function invitePath(inviteId) {
      return /databases/$(database)/documents/invites/$(inviteId);
    }

    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function hasExactly(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }

    function isCaller(person) {
      return person is map
        && hasExactly(person, ['uid', 'name', 'photoURL'])
        && person.uid == request.auth.uid
        && person.name is string
        && person.name.size() <= 200
        && (person.photoURL == null || person.photoURL is string);
    }

    function isTextOfLength(value, max) {
      return value is string && value.size() >= 1 && value.size() <= max;
    }

    match /boards/{boardId} {
      function isMember() {
        return request.auth.uid in resource.data.members;
      }

      function isValidNewBoard() {
        let board = request.resource.data;
        return hasExactly(board, ['name', 'members', 'currentInviteId', 'createdBy', 'createdAt'])
          && isTextOfLength(board.name, 60)
          && board.members == [request.auth.uid]
          && board.currentInviteId == null
          && board.createdBy == request.auth.uid
          && board.createdAt == request.time;
      }

      // A member of a two-person board removes only themselves (DATA-6).
      function isLeaving() {
        return isMember()
          && changedOnly(['members'])
          && resource.data.members.size() == 2
          && request.resource.data.members == resource.data.members.removeAll([request.auth.uid]);
      }

      // The invite must be unused before this batch as well as used by the caller after it.
      // Checking only the after-state would let someone who left rejoin through the old link.
      function isJoining() {
        let inviteId = resource.data.currentInviteId;
        return !isMember()
          && changedOnly(['members'])
          && resource.data.members.size() == 1
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
          && inviteId != null
          && get(invitePath(inviteId)).data.usedBy == null
          && getAfter(invitePath(inviteId)).data.usedBy == request.auth.uid;
      }

      function isReplacingInvite() {
        let inviteId = request.resource.data.currentInviteId;
        return isMember()
          && changedOnly(['currentInviteId'])
          && resource.data.members.size() == 1
          && inviteId is string
          && getAfter(invitePath(inviteId)).data.boardId == boardId;
      }

      allow get, list: if isAllowed() && isMember();
      allow create: if isAllowed() && isValidNewBoard();
      allow update: if isAllowed() && (isLeaving() || isJoining() || isReplacingInvite());
      allow delete: if isAllowed() && isMember() && resource.data.members.size() == 1;

      match /items/{itemId} {
        function isBoardMember() {
          return request.auth.uid in get(boardPath(boardId)).data.members;
        }

        function isValidTitle(title) {
          return isTextOfLength(title, 200);
        }

        function isValidOrder(order) {
          return isTextOfLength(order, 256);
        }

        function isValidNewItem() {
          let item = request.resource.data;
          return hasExactly(item, ['title', 'order', 'createdBy', 'createdAt', 'completedBy', 'completedAt', 'notes'])
            && isValidTitle(item.title)
            && isValidOrder(item.order)
            && isCaller(item.createdBy)
            && item.createdAt == request.time
            && item.completedBy == null
            && item.completedAt == null
            && item.notes is map
            && item.notes.size() == 0;
        }

        function isEditingTitle() {
          return changedOnly(['title']) && isValidTitle(request.resource.data.title);
        }

        function isReordering() {
          return changedOnly(['order'])
            && isValidOrder(request.resource.data.order)
            && resource.data.completedBy == null;
        }

        function isCompleting() {
          return changedOnly(['completedBy', 'completedAt'])
            && resource.data.completedBy == null
            && isCaller(request.resource.data.completedBy)
            && request.resource.data.completedAt == request.time;
        }

        function isRestoring() {
          return changedOnly(['completedBy', 'completedAt', 'order'])
            && resource.data.completedBy != null
            && request.resource.data.completedBy == null
            && request.resource.data.completedAt == null
            && isValidOrder(request.resource.data.order);
        }

        function isValidNewNote(note) {
          return note is map
            && hasExactly(note, ['text', 'author', 'createdAt'])
            && isTextOfLength(note.text, 140)
            && isCaller(note.author)
            && note.createdAt == request.time;
        }

        // A Set can't return an element, so the changed key comes from a list difference.
        // Requiring one affected key stops a write from also changing or removing another note.
        function isAddingNote() {
          let after = request.resource.data.notes;
          let before = resource.data.notes;
          let added = after.keys().removeAll(before.keys());
          return changedOnly(['notes'])
            && after.diff(before).affectedKeys().size() == 1
            && added.size() == 1
            && isValidNewNote(after[added[0]]);
        }

        function isDeletingOwnNote() {
          let after = request.resource.data.notes;
          let before = resource.data.notes;
          let removed = before.keys().removeAll(after.keys());
          return changedOnly(['notes'])
            && after.diff(before).affectedKeys().size() == 1
            && removed.size() == 1
            && before[removed[0]].author.uid == request.auth.uid;
        }

        allow read: if isAllowed() && isBoardMember();
        allow create: if isAllowed() && isBoardMember() && isValidNewItem();
        allow delete: if isAllowed() && isBoardMember();
        allow update: if isAllowed() && isBoardMember() && (
          isEditingTitle()
          || isReordering()
          || isCompleting()
          || isRestoring()
          || isAddingNote()
          || isDeletingOwnNote()
        );
      }
    }

    match /invites/{inviteId} {
      // This must not read resource.data: a missing invite has to come back as "not found",
      // not as permission denied, so the invite page can explain it (INV-5).
      allow get: if isAllowed();
      allow list: if false;

      function isValidNewInvite() {
        let invite = request.resource.data;
        let board = get(boardPath(invite.boardId)).data;
        return hasExactly(invite, ['boardId', 'boardName', 'inviterName', 'createdBy', 'expiresAt', 'usedBy'])
          && request.auth.uid in board.members
          && board.members.size() == 1
          && invite.boardName == board.name
          && isTextOfLength(invite.inviterName, 200)
          && invite.createdBy == request.auth.uid
          && invite.usedBy == null
          && getAfter(boardPath(invite.boardId)).data.currentInviteId == inviteId
          // No lower limit: a past expiry harms nobody, and tests need one (no Admin SDK).
          && invite.expiresAt is timestamp
          && invite.expiresAt <= request.time + duration.value(7, 'd') + duration.value(5, 'm');
      }

      // getAfter stops an invite from being used up without its holder joining the board.
      function isBeingUsed() {
        return changedOnly(['usedBy'])
          && resource.data.usedBy == null
          && request.resource.data.usedBy == request.auth.uid
          && request.time < resource.data.expiresAt
          && request.auth.uid in getAfter(boardPath(resource.data.boardId)).data.members;
      }

      allow create: if isAllowed() && isValidNewInvite();
      allow update: if isAllowed() && isBeingUsed();
      allow delete: if isAllowed()
        && request.auth.uid in get(boardPath(resource.data.boardId)).data.members;
    }
  }
}
